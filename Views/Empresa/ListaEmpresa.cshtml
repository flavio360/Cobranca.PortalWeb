@using Cobranca.PortalWeb.Domain.Common
@using Cobranca.PortalWeb.Models.Response.Empresa

@model IEnumerable<EmpresaResponse>

@* <link rel="stylesheet" href="~/css/impacto-theme.css" /> *@
<link rel="stylesheet" href="~/css/components/Impacto_Table.css" />
@await Html.PartialAsync("_ModalUpdateEmpresa")

<partial name="_TituloComponentes" model='"Cadastro Empresas Impacto"' />

<div class="impacto_actions" style="margin-bottom:1px;">
    <button class="impacto_btn impacto_btn_add"
            data-bs-toggle="modal"
            data-bs-target="#modalNovaEmpresa">

        <i class="bi bi-plus-lg"></i>
        Novo
    </button>
</div>

@await Html.PartialAsync("_ModalNovaEmpresa")

<div class="impacto_table-wrapper">

    <table class="impacto_table">

        <thead>
            <tr>
                <th>Ação</th>
                <th>ID</th>
                <th>Nome</th>
                <th>Fantasia</th>
                <th>CNPJ</th>
                <th>IE</th>
                <th>IM</th>
                <th>CEP</th>
                <th>Logradouro</th>
                <th>Número</th>
                <th>Complemento</th>
                <th>Bairro</th>
                <th>Cidade</th>
                <th>Estado</th>
                <th>Telefone</th>
                <th>Email</th>
                <th>Site</th>
                <th>CNAE</th>
                <th>Status</th>
                <th>Data Cadastro</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="impacto_actions_cell">

                            <button class="impacto_btn_icon impacto-btn-editar"
                                    data-id="@item.ImpactoEmpresaCadastroId"
                                    title="Editar">
                                <img src="@Url.Content("~/assets/icones/Editar48.svg")" />
                            </button>

                            <button class="impacto_btn_icon danger" title="Excluir">
                                <img src="@Url.Content("~/assets/icones/delete48.svg")" />
                            </button>

                        </td>
                        <td>@item.ImpactoEmpresaCadastroId</td>
                        <td>@item.EmpresaNome</td>
                        <td>@item.EmpresaNomeFantasia</td>
                        <td>@StringUtilitys.MaskCNPJ(item.EmpresaCNPJ)</td>
                        <td>@StringUtilitys.MaskIE(item.IE)</td>
                        <td>@item.IM</td>
                        <td>@StringUtilitys.MaskCEP(item.CEP)</td>
                        <td>@item.Logradouro</td>
                        <td>@item.Numero</td>
                        <td>@item.Complemento</td>
                        <td>@item.Bairro</td>
                        <td>@item.Cidade</td>
                        <td>@item.Estado</td>
                        <td>@StringUtilitys.MaskTelefone(item.Telefone)</td>
                        <td>@item.Email</td>
                        <td>@item.Site</td>
                        <td>@item.CNAE</td>

                        <td>
                            @if (item.Ativo == true)
                            {
                                <span class="impacto_status-ativo">Ativo</span>
                            }
                            else
                            {
                                <span class="impacto_status-inativo">Inativo</span>
                            }
                        </td>

                        <td>@(item.DataCadastro?.ToString("dd/MM/yyyy"))</td>

                        
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="20">Nenhum registro encontrado</td>
                </tr>
            }
        </tbody>

    </table>

</div>


@section Scripts {

    <script>

        document.addEventListener("click", function (e) {

        const btn = e.target.closest(".impacto-btn-editar");

        if (!btn) return;

        const row = btn.closest("tr");

        const cells = row.querySelectorAll("td");

        function setValue(id, value){
        const el = document.getElementById(id);
        if(el) el.value = value.trim();
        }

        setValue("update_Id", cells[1].innerText);
        setValue("update_EmpresaNome", cells[2].innerText);
        setValue("update_EmpresaNomeFantasia", cells[3].innerText);
        setValue("update_CNPJ", cells[4].innerText);
        setValue("update_IE", cells[5].innerText);
        setValue("update_IM", cells[6].innerText);
        setValue("update_CEP", cells[7].innerText);
        setValue("update_Logradouro", cells[8].innerText);
        setValue("update_Numero", cells[9].innerText);
        setValue("update_Complemento", cells[10].innerText);
        setValue("update_Bairro", cells[11].innerText);
        setValue("update_Cidade", cells[12].innerText);
        setValue("update_Estado", cells[13].innerText);
        setValue("update_Telefone", cells[14].innerText);
        setValue("update_Email", cells[15].innerText);
        setValue("update_Site", cells[16].innerText);
        setValue("update_CNAE", cells[17].innerText);

        const modal = new bootstrap.Modal(
        document.getElementById("modalUpdateEmpresa")
        );

        modal.show();

        });

    </script>

}

}