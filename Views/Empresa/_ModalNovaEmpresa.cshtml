<link rel="stylesheet" href="~/css/pages/Impacto_Modal.css" />

<div class="modal fade" id="modalNovaEmpresa" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content impacto_modal">

            <div class="impacto_modal_header">
                <h5>Nova Empresa</h5>

                <button class="impacto_modal_close" data-bs-dismiss="modal">
                    ✕
                </button>
            </div>

            <div class="impacto_modal_body">

                <form class="impacto_form">

                    <div class="impacto_form_grid">

                        <div class="impacto_form_group">
                            <label>Nome</label>
                            <input class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>Fantasia</label>
                            <input class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>CNPJ</label>
                            <input class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>IE</label>
                            <input class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>IM</label>
                            <input class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>CEP</label>
                            <input class="impacto_input" />
                        </div>

                        <div class="impacto_form_group impacto_col_span_2">
                            <label>Logradouro</label>
                            <input class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>Número</label>
                            <input class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>Complemento</label>
                            <input class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>Bairro</label>
                            <input class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>Cidade</label>
                            <input class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>Estado</label>
                            <input class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>Telefone</label>
                            <input class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>Email</label>
                            <input class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>Site</label>
                            <input class="impacto_input" />
                        </div>

                        <div class="impacto_form_group impacto_col_span_2">
                            <label>CNAE</label>
                            <input class="impacto_input" />
                        </div>

                    </div>

                </form>

            </div>

            <div class="impacto_modal_footer">
                <button class="impacto_btn" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button class="impacto_btn impacto_btn_add">
                    Salvar
                </button>
            </div>

        </div>
    </div>
</div>