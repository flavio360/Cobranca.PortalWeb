<link rel="stylesheet" href="~/css/pages/impacto.modal.css" />
<script src="~/js/Utils/string.mascaras.js"></script>


<div class="modal fade" id="modalNovaEmpresa" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content impacto_modal">

            <form id="formNovaEmpresa"
                  method="post"
                  asp-controller="Empresa"
                  asp-action="NovaEmpresa"
                  class="impacto_form impacto-form-ajax">

                <div class="impacto_modal_header">
                    <h5>Nova Empresa</h5>

                    <button type="button" class="impacto_modal_close" data-bs-dismiss="modal">
                        ✕
                    </button>
                </div>

                <div class="impacto_modal_body">

                    <div class="impacto_form_grid">

                        <div class="impacto_form_group">
                            <label>Nome</label>
                            <input name="EmpresaNome" maxlength="150" class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>Fantasia</label>
                            <input name="EmpresaNomeFantasia" maxlength="150" class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>CNPJ</label>
                            <input name="EmpresaCNPJ"
                                   maxlength="18"
                                   inputmode="numeric"
                                   data-mask="cnpj"
                                   class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>IE</label>
                            <input name="IE"
                                   maxlength="20"
                                   inputmode="numeric"
                                   data-mask="numbers"
                                   class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>IM</label>
                            <input name="IM"
                                   maxlength="20"
                                   inputmode="numeric"
                                   data-mask="numbers"
                                   class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>CEP</label>
                            <input name="CEP"
                                   maxlength="9"
                                   inputmode="numeric"
                                   data-mask="cep"
                                   class="impacto_input" />
                        </div>

                        <div class="impacto_form_group impacto_col_span_2">
                            <label>Logradouro</label>
                            <input name="Logradouro" maxlength="200" class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>Número</label>
                            <input name="Numero"
                                   maxlength="10"
                                   inputmode="numeric"
                                   data-mask="numbers"
                                   class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>Complemento</label>
                            <input name="Complemento" maxlength="100" class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>Bairro</label>
                            <input name="Bairro" maxlength="100" class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>Cidade</label>
                            <input name="Cidade" maxlength="100" class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>Estado</label>
                            <input name="Estado" maxlength="2" class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>Telefone</label>
                            <input name="Telefone"
                                   maxlength="15"
                                   inputmode="numeric"
                                   data-mask="telefone"
                                   class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>Email</label>
                            <input name="Email"
                                   type="email"
                                   maxlength="150"
                                   class="impacto_input" />
                        </div>

                        <div class="impacto_form_group">
                            <label>Site</label>
                            <input name="Site"
                                   maxlength="150"
                                   class="impacto_input" />
                        </div>

                        <div class="impacto_form_group impacto_col_span_2">
                            <label>CNAE</label>
                            <input name="CNAE"
                                   maxlength="20"
                                   class="impacto_input" />
                        </div>

                    </div>

                </div>

                <div class="impacto_modal_footer">
                    <button type="button" class="impacto_btn" data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit" class="impacto_btn impacto_btn_add">
                        Salvar
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>